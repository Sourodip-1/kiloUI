{
  "mcpServers": {
    "kilo-ui": {
      "command": "python3",
      "args": [
        "/home/souro/Documents/Codes/kiloUI/server/mcp_server.py",
        "--transport",
        "stdio"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONPATH": "/home/souro/Documents/Codes/kiloUI"
      }
    },
    "kilo-ui-streamable-http": {
      "url": "http://127.0.0.1:8000/mcp"
    },
    "kilo-ui-remote-bridge": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "http://127.0.0.1:8000/mcp"
      ],
      "env": {}
    }
  }
}
